generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model User {
  id                 Int      @id @default(autoincrement())
  firstName          String
  lastName           String
  email              String   @unique  // ✅ this is the key fix
  password           String
  contactNumber      String
  role               String
  profileImage       String?
  dateCreated        DateTime @default(now())
  lastLogin          DateTime?
  verificationStatus Boolean  @default(false)

  items              Item[]
}

model Item {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  userId      Int
  user        User   @relation(fields: [userId], references: [id])
}
